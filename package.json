{
  "name": "ticket-in",
  "version": "1.0.0",
  "description": "High-concurrency concert ticket war backend platform",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "dev:simulator": "tsx watch src/entrypoints/payment-simulator.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "start:simulator": "node dist/entrypoints/payment-simulator.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:concurrency": "vitest run test/concurrency",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:check-invariants": "tsx scripts/invariant-check.ts",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.1.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@opentelemetry/api": "^1.9.0",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/kafka": "^10.16.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "dependency-cruiser": "^16.9.0",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "fast-check": "^3.23.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
