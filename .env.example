# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://ticketin:ticketin_dev_password@localhost:5432/ticketin_db
DATABASE_MAX_CONNECTIONS=20

# Cache and Virtual Queue (Redis)
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# Message Broker (Apache Kafka KRaft)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ticket-in-service

# Cryptography and Authentication Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_minimum_32_chars_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_32_chars_12345
WAITING_ROOM_SECRET=dev_waiting_room_hmac_secret_key_minimum_32_chars
WEBHOOK_HMAC_SECRET=dev_webhook_signature_hmac_secret_minimum_32_chars

# Payment Simulator Process
PAYMENT_SIMULATOR_PORT=3001
PAYMENT_SIMULATOR_URL=http://localhost:3001
PAYMENT_SIMULATOR_LATENCY_MS=300
PAYMENT_SIMULATOR_FAILURE_RATE=0.05

# Waiting Room Rate Control
ADMISSION_RATE_PER_INTERVAL=50
ADMISSION_INTERVAL_MS=5000
HEARTBEAT_TTL_SECONDS=30
